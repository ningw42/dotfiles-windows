{{ if eq .chezmoi.os "windows" -}}
{{- $pinByArch := dict "amd64" .external_resources.pins.pi_distribution_windows_x64 "arm64" .external_resources.pins.pi_distribution_windows_arm64 -}}
{{- if not (hasKey $pinByArch .chezmoi.arch) -}}
{{- fail (printf "pi-distribution has no release asset for architecture %q" .chezmoi.arch) -}}
{{- end -}}
{{- $pin := index $pinByArch .chezmoi.arch -}}
["pi-distribution"]
    type = "archive"
    url = "{{ $pin.url }}"
    stripComponents = 1
    exact = true
    checksum.sha256 = "{{ $pin.sha256 }}"
{{ end -}}
