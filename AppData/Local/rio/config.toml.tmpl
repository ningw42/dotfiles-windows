# Rio terminal, targeting 0.5.x. Only what differs from upstream defaults lives
# here; the annotated reference is at https://rioterm.com/docs/config
#
# Two traps make this file confusing to debug (both verified against the 0.5.2
# source, rio-backend/src/config/mod.rs):
#   - An invalid *value* is catastrophic, not local. Config::load() catches any
#     deserialization error and returns Config::default(), so a single bad enum
#     variant silently discards every setting below -- font, theme, shell, all
#     of it -- behind a warning that goes nowhere at the default log level.
#   - An unknown *key* is ignored. Nothing here sets deny_unknown_fields, so
#     options deleted upstream (`padding-x`, `renderer.performance`,
#     `fonts.extras`) sit in the file looking authoritative while doing nothing.
# Fastest end-to-end check that rio actually accepted this file: it should spawn
# `pwsh -l`, not the default bare `powershell`.
#   $p = Start-Process rio -PassThru; Start-Sleep 5
#   Get-CimInstance Win32_Process -Filter "ParentProcessId = $($p.Id)"

theme = "{{.colorscheme}}"
confirm-before-quit = false
# Match Windows Terminal, which defaults to %USERPROFILE%; rio otherwise
# inherits the cwd of whatever launched it. Must be absolute -- the value is
# handed straight to create_pty with no tilde expansion, so "~" would be taken
# literally. Forward slashes are not cosmetic: a raw Windows path would put an
# invalid \U escape in this TOML string and fail the parse, which per the note
# above would discard the entire file.
working-dir = "{{ .chezmoi.homeDir | replace "\\" "/" }}"

[cursor]
shape = "block"
blinking = false

[renderer]
# 0.5 collapsed the old backend list ("Automatic"/"GL"/"DX12"/"Vulkan"/"Metal")
# down to Metal | Vulkan | Webgpu, and dropped `performance` and `level`
# outright. Webgpu is the umbrella that lets wgpu pick the best native API,
# which is DX12 on Windows -- so this is the previous `backend = "DX12"` intent
# spelled the way 0.5 understands. Literal "DX12" is now a hard parse failure.
backend = "Webgpu"

[fonts]
# 18.667 is 14pt, NOT a typo for 14. rio is the odd one out among the terminals
# here: alacritty, wezterm and Windows Terminal all take a size in *points*,
# while rio's is in logical pixels. sugarloaf/src/layout/mod.rs computes
# `cell_width = round(advance_em * size * scale_factor)` with no 96/72 anywhere,
# so matching a point size means converting by hand -- size = pt * 96/72.
# Setting 14 here renders at 75% of the other three, which looks like rio simply
# ignoring the config rather than a unit mismatch. Verified on this 192 DPI
# display: 0.4880 * 18.667 * 2 = 18.22 -> an 18px cell, the same cell Windows
# Terminal produces at 14pt.
size = 18.667
features = ["ss02"]
# The Retina cut ships only 25 of the 128 U+2500 box-drawing glyphs, so let rio
# draw them itself -- otherwise TUI borders in gitui/yazi/lazygit/zellij come out
# broken. Same reasoning as alacritty's builtin_box_drawing. Already the default,
# pinned because it is strictly required here: it is the only reason the other
# 103 box glyphs are not left to the arbitrary Windows cascade below.
use-drawable-chars = true
# 0.5 removed `fonts.extras`, which appended fallback families consulted only
# for glyphs the primary font lacked. `symbol-map` is the replacement, but it is
# a *forced* mapping rather than a fallback: a covered codepoint always renders
# from the mapped family even when the primary face has its own glyph. So map
# only what the regular face genuinely cannot serve and leave the rest to it.
#
# Every range below is load-bearing, and specifically because the regular slot is
# Retina (see the slot tables further down). Berkeley Mono ships two very
# different cuts here: the 400-weight "ExtraCondensed" file is the Nerd-patched
# one (10,960 glyphs), while Retina and Bold are plain 455-glyph cuts. So Retina
# has no icons at all -- what looks like belt-and-braces on an unpatched build is
# the only thing supplying them.
#
# Letting rio fall back automatically is not a real option here. Windows has no
# fontconfig equivalent in rio's dep tree, so sugarloaf/src/font/windows.rs walks
# every installed font and takes the *first* whose cmap has the codepoint --
# enumeration order, effectively arbitrary, and a wrong-width match visibly
# breaks prompt alignment.
#
# `end` is EXCLUSIVE: the loader builds a Rust `start..end` and tests it with
# Range::contains, so every end below is one past the last glyph covered.
symbol-map = [
    # Private Use Areas -- Nerd Fonts icons (Powerline, Devicons, Codicons, Font
    # Awesome, Octicons in the BMP; Material Design in plane 15). The standalone
    # symbols font is metrics-matched to the ExtraCondensed width, 0.4878 against
    # Berkeley's 0.4880 em advance, so the cell grid is unaffected.
    { start = "E000", end = "F900", font-family = "Symbols Nerd Font Berkeley Mono" },
    { start = "F0000", end = "FFFFE", font-family = "Symbols Nerd Font Berkeley Mono" },
    # The Nerd Fonts glyphs that sit outside the PUA. Retina lacks all 14, and
    # U+276C-2771 in particular are the powerline-extra separators a starship
    # prompt draws, so omitting these is immediately visible.
    { start = "23FB", end = "23FF", font-family = "Symbols Nerd Font Berkeley Mono" }, # IEC power
    { start = "2630", end = "2631", font-family = "Symbols Nerd Font Berkeley Mono" }, # trigram
    { start = "2665", end = "2666", font-family = "Symbols Nerd Font Berkeley Mono" }, # heart
    { start = "26A1", end = "26A2", font-family = "Symbols Nerd Font Berkeley Mono" }, # high voltage
    { start = "276C", end = "2772", font-family = "Symbols Nerd Font Berkeley Mono" }, # powerline-extra
    { start = "2B58", end = "2B59", font-family = "Symbols Nerd Font Berkeley Mono" }, # heavy circle
    # CJK -- Berkeley Mono has zero glyphs in any of these ranges, in either cut.
    # The first span runs radicals through Unified Ideographs; kana, bopomofo,
    # Hangul jamo, strokes, enclosed forms and Ext A sit inside it. Sarasa
    # advances a full em on ideographs, so they occupy two cells.
    { start = "2E80", end = "A000", font-family = "Sarasa Fixed SC" },
    { start = "AC00", end = "D7A4", font-family = "Sarasa Fixed SC" },   # Hangul syllables
    { start = "F900", end = "FB00", font-family = "Sarasa Fixed SC" },   # compatibility ideographs
    { start = "FE30", end = "FE50", font-family = "Sarasa Fixed SC" },   # compatibility forms
    { start = "FF00", end = "FFF0", font-family = "Sarasa Fixed SC" },   # half/fullwidth forms
    { start = "20000", end = "2FA20", font-family = "Sarasa Fixed SC" }, # Ext B-F + supplement
]

# Retina (weight 375) is the optical weight Berkeley draws for screens, matching
# Windows Terminal and alacritty. It cannot be spelled as a weight on the plain
# family, because rio resolves through font-kit's select_family_by_name -- i.e.
# DirectWrite -- and NOT the font's name table. The two disagree: the name table
# calls every face "Berkeley Mono", but DirectWrite promotes weight 375 into its
# own family, "Berkeley Mono Retina", whose faces are spelled "375". Asking
# "Berkeley Mono" for weight 375 therefore lands on its 400 "ExtraCondensed"
# face, since that family has no 375 in it at all.
#
# Root `fonts.family` is deliberately absent: it overwrites all four slot
# families (sugarloaf/src/font/mod.rs), which would drag bold along with it.
# Bold is pinned back to "Berkeley Mono" on purpose -- "Berkeley Mono Retina"
# does advertise an "ExtraCondensed 375 Bold" at weight 700, but no Retina Bold
# file exists, so that face is DirectWrite's algorithmic emboldening rather than
# a drawn one. Mixing the families is safe: every face involved advances
# 0.4880 em, so the cell grid is unchanged.
#
# The italic slots resolve to the Oblique faces on their own -- rio queries
# Style::Italic and the matcher's preference order is [Italic, Oblique, Normal].
[fonts.regular]
family = "Berkeley Mono Retina"
weight = 375

[fonts.italic]
family = "Berkeley Mono Retina"
weight = 375

[fonts.bold]
family = "Berkeley Mono"
weight = 700

[fonts.bold-italic]
family = "Berkeley Mono"
weight = 700

[navigation]
# 0.5 reduced the mode list to Plain | Tab | NativeTab (macOS only). The old
# "BottomTab"/"TopTab"/"Bookmark" are gone and parse-fail the entire file.
mode = "Tab"
clickable = false
hide-if-single = true
# `current-working-directory` (0.5's rename of `use-current-path`) is left at
# its default of true. It is inert on Windows regardless: the branch that would
# inherit the active tab's cwd is commented out in rioterm's context module and
# just assigns None, which the `is_some()` guard below it then drops -- so new
# tabs and splits fall back to `working-dir` above either way.

[bindings]
# Ctrl+Shift+W is a dead end on the last tab, silently. Screen::close_tab defers
# to ContextManager::close_current_context, which opens with
# `if self.contexts.len() == 1 { #[cfg(target_os = "macos")] { ..CloseWindow }
# return; }` (rioterm/src/context/mod.rs) -- the arm that actually closes the
# window is macOS-only, so on Windows that whole branch reduces to a bare
# `return`. close_tab then takes its own `len() <= 1` path and only relayouts the
# tab strip, which is why the key visibly repaints while doing nothing.
# Ctrl+Shift+D bottoms out in the same place: close_split_or_tab falls through to
# close_tab once a single split is left. With decorations disabled that leaves no
# in-window way out at all -- only `exit` in the shell or Alt+F4 -- hence binding
# quit by hand. Rio ships no default quit binding off macOS (only Cmd+Q there).
#
# This is a hard process kill, not a window close: Act::Quit -> ContextManager
# ::quit -> RioEvent::Quit -> application.rs, which looks the route up by
# window_id -- so it reads window-scoped -- but then calls Route::quit, and that
# is `std::process::exit(0)` (rioterm/src/router/mod.rs). EVERY rio window dies,
# no unwinding, and `confirm-before-quit = false` above means no prompt either. Q
# is deliberately far from W for that reason; do not fold this onto Ctrl+Shift+W.
#
# Unlike everything else here, a typo on this table is survivable. KeyBinding is
# all-String fields (rio-backend/src/config/bindings.rs), so it always
# deserializes, and rioterm's converter returns Err per entry -- logged as
# "unknown action" and skipped -- rather than failing the parse and triggering
# the whole-file discard described at the top. `key` and `with` are both
# lowercased before matching and `|` separates modifiers.
keys = [{ key = "q", with = "control|shift", action = "quit" }]

[window]
decorations = "Disabled"
# DWMWA_WINDOW_CORNER_PREFERENCE. Not redundant with the Windows 11 default:
# the field is an Option that defaults to None, so leaving it out means rio
# never calls DwmSetWindowAttribute at all rather than asking for "round".
# This does still apply with decorations off -- configure_window() sets it
# unconditionally on Windows, and rio-window's to_window_styles always keeps
# WS_CAPTION | WS_BORDER (undecorated is implemented by stripping the
# non-client area in WM_NCCALCSIZE, not by dropping the styles), so DWM still
# sees a framed window to round. Spelling is load-bearing per the header note:
# the variants are Default | DoNotRound | Round | RoundSmall with lowercase
# aliases only, so "round-small" would fail the enum and discard this file.
windows-corner-preference = "Round"

[platform]
windows.shell.program = "pwsh"
windows.shell.args = ["-l"]
# Rio is the odd one out among Windows terminals in leaving TERM unset: its
# setup_environment_variables sets it only under #[cfg(unix)] (rioterm/src/main.rs),
# while alacritty and wezterm both set it on Windows too. That omission breaks
# zellij, which picks its Windows stdin reader with
# `env::var("TERM").is_ok() && enable_vt_input()`. Unset TERM drops it onto the
# native console path (INPUT_RECORDs via ReadConsoleInput), which never constructs
# KittyKeyboardParser -- that lives only on the VT-byte path. Meanwhile zellij's
# client unconditionally asks the host for the kitty keyboard protocol (ESC[>1u),
# rio honours it, and every key comes back as CSI u the reader cannot decode:
# Esc -> `[27u`, Ctrl+C -> `[99;5u`, and neovim's insert mode becomes inescapable.
# Upstream is zellij#5017; zellij#5335 fixes only Windows Terminal, keying off
# WT_SESSION, which rio never sets. Setting TERM here flips zellij onto the VT
# path so its kitty parser actually runs -- the alternative,
# `support_kitty_keyboard_protocol false` in zellij, works too but gives up
# enhanced keys entirely. Two bits of plumbing make this land: the platform merge
# (main.rs:174) runs before setup_environment_variables (main.rs:235), so these
# are appended to the global env-vars in time, and the ConPTY spawn passes
# lpEnvironment = NULL (teletypewriter/src/windows/conpty.rs), so pwsh inherits
# rio's process environment. Scoped to `windows.` deliberately: a global
# `env-vars` would also clobber the xterm-rio terminfo rio picks on Unix.
windows.env-vars = ["TERM=xterm-256color"]
