# zjstatus — zellij status-bar WASM plugin, referenced via file: in
# layouts/default.kdl. Its latest GitHub release and checksum are refreshed by
# `python update_externals.py` through the pin in .chezmoidata.toml.
["zjstatus.wasm"]
    type = "file"
    url = "{{ .external_resources.pins.zjstatus.url }}"
    checksum.sha256 = "{{ .external_resources.pins.zjstatus.sha256 }}"
    refreshPeriod = "168h"
