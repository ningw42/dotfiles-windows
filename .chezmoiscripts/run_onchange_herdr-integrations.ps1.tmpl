{{ if eq .chezmoi.os "windows" -}}
{{- $herdrPath := printf "%s/scoop/shims/herdr.exe" (.chezmoi.homeDir | replace "\\" "/") -}}
{{- /*
  Materialize HerdR's release-matched integrations without letting its installer
  mutate the Claude/Codex/Copilot configuration files owned by chezmoi. The
  installed binary is the source of truth for the hook/plugin implementations,
  just as nixfiles runs `herdr integration install` in an isolated Nix build
  HOME.

  Embedding the installed version in this rendered script makes chezmoi rerun
  it after a HerdR upgrade. The migration gate below then requires an explicit
  review whenever that binary changes an integration format.
*/ -}}
# HerdR version: {{ output $herdrPath "--version" | trim }}
param(
    [string]$HerdrPath = '{{ $herdrPath }}',
    [string]$HomeRoot = '{{ .chezmoi.homeDir | replace "\\" "/" }}',
    [string]$SkillOutputPath = ''
)

$ErrorActionPreference = 'Stop'
$utf8NoBom = [Text.UTF8Encoding]::new($false)
$expectedIntegrationVersions = [ordered]@{
    pi = 8
    claude = 9
    codex = 8
    copilot = 3
    opencode = 11
}

if (-not (Test-Path -LiteralPath $HerdrPath -PathType Leaf)) {
    throw "HerdR was not found at '$HerdrPath'. Run 'winget configure -f configuration.dsc.yaml' first."
}
if ([string]::IsNullOrWhiteSpace($SkillOutputPath)) {
    $SkillOutputPath = Join-Path $HomeRoot '.local/share/herdr/skills/herdr/SKILL.md'
}

function Invoke-Herdr(
    [string[]]$Arguments,
    [hashtable]$Environment = @{},
    [string]$WorkingDirectory = $HomeRoot
) {
    $startInfo = [Diagnostics.ProcessStartInfo]::new()
    $startInfo.FileName = $HerdrPath
    $startInfo.WorkingDirectory = $WorkingDirectory
    $startInfo.UseShellExecute = $false
    $startInfo.RedirectStandardOutput = $true
    $startInfo.RedirectStandardError = $true
    foreach ($argument in $Arguments) {
        $startInfo.ArgumentList.Add($argument)
    }
    foreach ($entry in $Environment.GetEnumerator()) {
        $startInfo.Environment[$entry.Key] = [string]$entry.Value
    }

    $process = [Diagnostics.Process]::Start($startInfo)
    $stdout = $process.StandardOutput.ReadToEnd()
    $stderr = $process.StandardError.ReadToEnd()
    $process.WaitForExit()
    if ($process.ExitCode -ne 0) {
        $command = @($Arguments) -join ' '
        throw "HerdR command '$command' failed (exit $($process.ExitCode)): $stderr"
    }
    return $stdout
}

function Test-HerdrOwnedFile([string]$Path, [string]$IntegrationId) {
    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        return $false
    }
    $content = [IO.File]::ReadAllText($Path)
    return (
        $content.Contains('installed by herdr') -and
        $content.Contains("HERDR_INTEGRATION_ID=$IntegrationId")
    )
}

function Copy-FileAtomically([string]$Source, [string]$Destination) {
    $destinationDirectory = Split-Path -Parent $Destination
    New-Item -ItemType Directory -Path $destinationDirectory -Force | Out-Null
    if (Test-Path -LiteralPath $Destination -PathType Leaf) {
        $sourceHash = (Get-FileHash -LiteralPath $Source -Algorithm SHA256).Hash
        $destinationHash = (Get-FileHash -LiteralPath $Destination -Algorithm SHA256).Hash
        if ($sourceHash -ceq $destinationHash) {
            return
        }
    }

    $temporaryDestination = "$Destination.chezmoi-herdr-$([Guid]::NewGuid().ToString('N')).tmp"
    try {
        Copy-Item -LiteralPath $Source -Destination $temporaryDestination
        [IO.File]::Move($temporaryDestination, $Destination, $true)
    }
    finally {
        Remove-Item -LiteralPath $temporaryDestination -Force -ErrorAction SilentlyContinue
    }
}

function Set-HerdrIntegrationFile(
    [string]$Source,
    [string]$Destination,
    [string]$IntegrationId,
    [int]$ExpectedVersion
) {
    if (-not (Test-HerdrOwnedFile $Source $IntegrationId)) {
        throw "Generated integration '$Source' has no valid HerdR ownership marker for '$IntegrationId'."
    }

    $sourceContent = [IO.File]::ReadAllText($Source)
    $versionMatch = [regex]::Match($sourceContent, 'HERDR_INTEGRATION_VERSION=([0-9]+)')
    $actualVersion = if ($versionMatch.Success) { $versionMatch.Groups[1].Value } else { 'unknown' }
    if (-not $versionMatch.Success -or [int]::Parse($actualVersion) -ne $ExpectedVersion) {
        throw "HerdR '$IntegrationId' integration changed: expected v$ExpectedVersion, generated v$actualVersion. Review the migration before updating the gate."
    }

    if ((Test-Path -LiteralPath $Destination) -and -not (Test-HerdrOwnedFile $Destination $IntegrationId)) {
        throw "Refusing to overwrite non-HerdR file '$Destination'."
    }
    Copy-FileAtomically -Source $Source -Destination $Destination
}

function Set-TextFile([string]$Path, [string]$Content) {
    $directory = Split-Path -Parent $Path
    New-Item -ItemType Directory -Path $directory -Force | Out-Null
    $existing = if (Test-Path -LiteralPath $Path -PathType Leaf) {
        [IO.File]::ReadAllText($Path)
    } else {
        $null
    }
    if ($existing -cne $Content) {
        [IO.File]::WriteAllText($Path, $Content, $utf8NoBom)
    }
}

function Test-HerdrOpenCodeTuiConfig([string]$Path) {
    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        return $false
    }
    try {
        $config = [IO.File]::ReadAllText($Path) | ConvertFrom-Json
    }
    catch {
        return $false
    }

    $properties = @($config.PSObject.Properties.Name)
    $plugins = @($config.plugin)
    return (
        $properties.Count -eq 1 -and
        $properties[0] -ceq 'plugin' -and
        $plugins.Count -eq 1 -and
        [string]$plugins[0] -ceq './herdr-tui-session.js'
    )
}

function Set-HerdrOpenCodeTuiConfig([string]$Source, [string]$Destination) {
    if (-not (Test-HerdrOpenCodeTuiConfig $Source)) {
        throw "Generated OpenCode TUI config '$Source' has an unexpected format."
    }
    if ((Test-Path -LiteralPath $Destination) -and -not (Test-HerdrOpenCodeTuiConfig $Destination)) {
        throw "Refusing to overwrite non-HerdR OpenCode TUI config '$Destination'."
    }
    Copy-FileAtomically -Source $Source -Destination $Destination
}

function Test-HerdrCopilotHookConfig([string]$Path) {
    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        return $false
    }
    try {
        $config = [IO.File]::ReadAllText($Path) | ConvertFrom-Json
    }
    catch {
        return $false
    }

    $hooks = @($config.hooks.SessionStart)
    if ($hooks.Count -ne 1) {
        return $false
    }
    $hook = $hooks[0]
    return (
        [int]$config.version -eq 1 -and
        [string]$hook.type -ceq 'command' -and
        [int]$hook.timeoutSec -eq 10 -and
        [string]$hook.powershell -match '(?i)herdr-agent-state\.ps1"?$'
    )
}

function Set-HerdrCopilotHookConfig([string]$Path, [string]$HookPath) {
    if ((Test-Path -LiteralPath $Path) -and -not (Test-HerdrCopilotHookConfig $Path)) {
        throw "Refusing to overwrite non-HerdR Copilot hook config '$Path'."
    }

    $normalizedHookPath = [IO.Path]::GetFullPath($HookPath).Replace('\', '/')
    $definition = [ordered]@{
        version = 1
        hooks = [ordered]@{
            SessionStart = @(
                [ordered]@{
                    type = 'command'
                    powershell = "pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File `"$normalizedHookPath`""
                    timeoutSec = 10
                }
            )
        }
    }
    $content = ($definition | ConvertTo-Json -Depth 8) + "`n"
    Set-TextFile -Path $Path -Content $content
}

function Set-HerdrSkillLink([string]$Path, [string]$Target) {
    $normalizedTarget = [IO.Path]::GetFullPath($Target)
    $existing = Get-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue
    if ($null -ne $existing) {
        $storedTargets = @(if ($null -eq $existing.LinkType) { @() } else { @($existing.LinkTarget) })
        $owned = (
            $existing.LinkType -eq 'SymbolicLink' -and
            $existing.PSIsContainer -and
            $storedTargets.Count -eq 1 -and
            [IO.Path]::IsPathFullyQualified([string]$storedTargets[0]) -and
            [IO.Path]::GetFullPath([string]$storedTargets[0]).Equals(
                $normalizedTarget,
                [StringComparison]::OrdinalIgnoreCase
            )
        )
        if (-not $owned) {
            throw "Refusing non-owned HerdR skill collision at '$Path'."
        }
        return
    }

    New-Item -ItemType Directory -Path (Split-Path -Parent $Path) -Force | Out-Null
    New-Item -ItemType SymbolicLink -Path $Path -Target $normalizedTarget | Out-Null
}

$work = Join-Path ([IO.Path]::GetTempPath()) ("chezmoi-herdr-{0}" -f [Guid]::NewGuid().ToString('N'))
try {
    $profile = Join-Path $work 'home'
    $xdgConfig = Join-Path $profile '.config'
    $appData = Join-Path $profile 'AppData/Roaming'
    $localAppData = Join-Path $profile 'AppData/Local'
    New-Item -ItemType Directory -Force -Path @(
        (Join-Path $profile '.pi/agent'),
        (Join-Path $profile '.claude'),
        (Join-Path $profile '.codex'),
        (Join-Path $profile '.copilot'),
        (Join-Path $xdgConfig 'opencode'),
        $appData,
        $localAppData
    ) | Out-Null

    Set-TextFile (Join-Path $profile '.claude/settings.json') "{}`n"
    Set-TextFile (Join-Path $profile '.codex/config.toml') ''
    Set-TextFile (Join-Path $profile '.codex/hooks.json') "{}`n"
    Set-TextFile (Join-Path $profile '.copilot/settings.json') "{}`n"
    Set-TextFile (Join-Path $xdgConfig 'opencode/opencode.json') "{}`n"

    $isolatedEnvironment = @{
        HOME = $profile
        USERPROFILE = $profile
        XDG_CONFIG_HOME = $xdgConfig
        APPDATA = $appData
        LOCALAPPDATA = $localAppData
    }
    foreach ($integration in $expectedIntegrationVersions.Keys) {
        $null = Invoke-Herdr `
            -Arguments @('integration', 'install', $integration) `
            -Environment $isolatedEnvironment `
            -WorkingDirectory $profile
    }

    $integrations = @(
        @{
            Id = 'pi'
            ExpectedVersion = $expectedIntegrationVersions.pi
            Source = Join-Path $profile '.pi/agent/extensions/herdr-agent-state.ts'
            Destination = Join-Path $HomeRoot '.pi/agent/extensions/herdr-agent-state.ts'
        },
        @{
            Id = 'claude'
            ExpectedVersion = $expectedIntegrationVersions.claude
            Source = Join-Path $profile '.claude/hooks/herdr-agent-state.ps1'
            Destination = Join-Path $HomeRoot '.claude/hooks/herdr-agent-state.ps1'
        },
        @{
            Id = 'codex'
            ExpectedVersion = $expectedIntegrationVersions.codex
            Source = Join-Path $profile '.codex/herdr-agent-state.ps1'
            Destination = Join-Path $HomeRoot '.codex/herdr-agent-state.ps1'
        },
        @{
            Id = 'copilot'
            ExpectedVersion = $expectedIntegrationVersions.copilot
            Source = Join-Path $profile '.copilot/hooks/herdr-agent-state.ps1'
            Destination = Join-Path $HomeRoot '.copilot/hooks/herdr-agent-state.ps1'
        },
        @{
            Id = 'opencode'
            ExpectedVersion = $expectedIntegrationVersions.opencode
            Source = Join-Path $xdgConfig 'opencode/plugins/herdr-agent-state.js'
            Destination = Join-Path $HomeRoot '.config/opencode/plugins/herdr-agent-state.js'
        },
        @{
            Id = 'opencode-tui'
            ExpectedVersion = $expectedIntegrationVersions.opencode
            Source = Join-Path $xdgConfig 'opencode/herdr-tui-session.js'
            Destination = Join-Path $HomeRoot '.config/opencode/herdr-tui-session.js'
        }
    )
    foreach ($integration in $integrations) {
        Set-HerdrIntegrationFile `
            -Source $integration.Source `
            -Destination $integration.Destination `
            -IntegrationId $integration.Id `
            -ExpectedVersion $integration.ExpectedVersion
    }

    Set-HerdrOpenCodeTuiConfig `
        -Source (Join-Path $xdgConfig 'opencode/tui.jsonc') `
        -Destination (Join-Path $HomeRoot '.config/opencode/tui.jsonc')
    Set-HerdrCopilotHookConfig `
        -Path (Join-Path $HomeRoot '.copilot/hooks/herdr.json') `
        -HookPath (Join-Path $HomeRoot '.copilot/hooks/herdr-agent-state.ps1')

    $skill = Invoke-Herdr -Arguments @('--skill')
    if ([string]::IsNullOrWhiteSpace($skill) -or $skill -notmatch '(?m)^name:\s*herdr\s*$') {
        throw 'HerdR emitted an invalid or empty skill.'
    }
    Set-TextFile -Path $SkillOutputPath -Content $skill

    # Pi discovers the cross-agent standard path; explicit links for Claude,
    # Codex, Copilot, and OpenCode mirror nixfiles' per-program skill
    # declarations and avoid relying on incidental cross-agent discovery.
    foreach ($skillLink in @(
        (Join-Path $HomeRoot '.agents/skills/herdr'),
        (Join-Path $HomeRoot '.claude/skills/herdr'),
        (Join-Path $HomeRoot '.codex/skills/herdr'),
        (Join-Path $HomeRoot '.copilot/skills/herdr'),
        (Join-Path $HomeRoot '.config/opencode/skills/herdr')
    )) {
        Set-HerdrSkillLink -Path $skillLink -Target (Split-Path -Parent $SkillOutputPath)
    }
}
finally {
    if (Test-Path -LiteralPath $work) {
        Remove-Item -LiteralPath $work -Recurse -Force
    }
}
{{ end -}}
