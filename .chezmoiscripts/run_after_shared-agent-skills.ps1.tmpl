param(
    [string]$HomeRoot = '{{ .chezmoi.destDir | replace "\\" "/" | replace "'" "''" }}',
    [string]$PythonExecutable = '{{ .chezmoi.homeDir | replace "\\" "/" | replace "'" "''" }}/scoop/apps/python/current/python.exe',
    [switch]$DryRun
)

$ErrorActionPreference = 'Stop'
if (-not (Test-Path -LiteralPath $PythonExecutable -PathType Leaf)) {
    throw 'Managed Python is missing; provision Python 3.11+ before publishing skills.'
}
$publisher = '{{ .chezmoi.sourceDir | replace "\\" "/" | replace "'" "''" }}/manage_skills.py'
$arguments = @('-X', 'utf8', $publisher, '--home', $HomeRoot)
if ($DryRun) { $arguments += '--dry-run' }
& $PythonExecutable @arguments
if ($LASTEXITCODE -ne 0) {
    throw "Shared skill publication failed (exit $LASTEXITCODE). No migration or Claude cache operations were attempted."
}
