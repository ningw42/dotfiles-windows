{{ if eq .chezmoi.os "windows" -}}
param(
    [string]$PiDistributionRoot = '{{ .chezmoi.homeDir | replace "\\" "/" }}/.pi/agent/packages/pi-distribution',
    [string]$OutputDirectory = '{{ .chezmoi.homeDir | replace "\\" "/" }}/.pi/agent/agents'
)

$ErrorActionPreference = 'Stop'

$subagentsRoot = Join-Path $PiDistributionRoot 'node_modules/@tintinweb/pi-subagents'
$requiredSources = @('default-agents.ts', 'agent-file-toggle.ts', 'types.ts')
foreach ($sourceName in $requiredSources) {
    $sourcePath = Join-Path $subagentsRoot "src/$sourceName"
    if (-not (Test-Path -LiteralPath $sourcePath -PathType Leaf)) {
        throw "The installed pi-subagents package is missing '$sourcePath'. Reapply the pinned pi-distribution external."
    }
}

$node = Join-Path $env:USERPROFILE 'scoop/apps/nodejs/current/node.exe'
if (-not (Test-Path -LiteralPath $node -PathType Leaf)) {
    throw "Node.js was not found at '$node'. Install the Scoop nodejs dependency before applying this source."
}

# Frontmatter pins outrank Agent tool model parameters. Keep the fast explorer
# and large planner explicit while allowing general-purpose to inherit caller
# selection or the parent model.
$agentModels = [ordered]@{
    Explore = 'copilotd-openai/gpt-5.6-sol-fast'
    Plan = 'copilotd-openai/gpt-6-astra'
    'general-purpose' = $null
}

$work = Join-Path ([IO.Path]::GetTempPath()) ("chezmoi-pi-agents-{0}" -f [Guid]::NewGuid().ToString('N'))
try {
    $sourceDir = Join-Path $work 'src'
    $stubDir = Join-Path $work 'node_modules/@earendil-works/pi-coding-agent'
    New-Item -ItemType Directory -Path $sourceDir, $stubDir -Force | Out-Null

    foreach ($sourceName in $requiredSources) {
        Copy-Item -LiteralPath (Join-Path $subagentsRoot "src/$sourceName") -Destination $sourceDir
    }

    $agentFileTogglePath = Join-Path $sourceDir 'agent-file-toggle.ts'
    if (-not (Select-String -LiteralPath $agentFileTogglePath -SimpleMatch 'from "./custom-agents.js"' -Quiet)) {
        throw 'pi-subagents no longer imports custom-agents.js; remove its build-only shim.'
    }
    $upstreamCustomAgentsPath = Join-Path $subagentsRoot 'src/custom-agents.js'
    if (Test-Path -LiteralPath $upstreamCustomAgentsPath) {
        throw 'pi-subagents now ships src/custom-agents.js; remove its build-only shim.'
    }

    $utf8NoBom = [Text.UTF8Encoding]::new($false)

    # serializeAgentFile does not use parseAgentFrontmatter, but its module imports
    # that helper at load time. Stub the unused edge instead of copying the loader's
    # growing runtime dependency graph into this isolated generator.
    [IO.File]::WriteAllText(
        (Join-Path $sourceDir 'custom-agents.js'),
        'export function parseAgentFrontmatter() {' + "`n" +
        '  throw new Error("build-only custom-agents.js shim was unexpectedly called");' + "`n" +
        '}' + "`n",
        $utf8NoBom
    )
    [IO.File]::WriteAllText(
        (Join-Path $stubDir 'package.json'),
        "{ `"name`": `"@earendil-works/pi-coding-agent`", `"main`": `"index.js`" }`n",
        $utf8NoBom
    )
    [IO.File]::WriteAllText(
        (Join-Path $stubDir 'index.js'),
        "exports.getAgentDir = () => `".`";`n",
        $utf8NoBom
    )

    $generatorPath = Join-Path $work 'generate.mjs'
    [IO.File]::WriteAllText(
        $generatorPath,
        @'
const { DEFAULT_AGENTS } = await import("./src/default-agents.ts");
const { serializeAgentFile } = await import("./src/agent-file-toggle.ts");

const agentModels = new Map(Object.entries(JSON.parse(process.env.AGENT_MODELS_JSON)));
const generated = {};
for (const [name, model] of agentModels) {
  const builtin = DEFAULT_AGENTS.get(name);
  if (!builtin) throw new Error(`pi-subagents has no built-in ${name} agent`);

  const agent = { ...builtin };
  if (model === null) delete agent.model;
  else agent.model = model;
  const serialized = serializeAgentFile(agent);
  const modelLine = serialized.match(/^model: (.*)$/m)?.[1] ?? null;
  if (modelLine !== model) throw new Error(`${name} model pin was not applied`);
  generated[name] = serialized;
}
process.stdout.write(JSON.stringify(generated));
'@,
        $utf8NoBom
    )

    $startInfo = [Diagnostics.ProcessStartInfo]::new()
    $startInfo.FileName = $node
    $startInfo.WorkingDirectory = $work
    $startInfo.UseShellExecute = $false
    $startInfo.RedirectStandardOutput = $true
    $startInfo.RedirectStandardError = $true
    $startInfo.Environment['AGENT_MODELS_JSON'] = ($agentModels | ConvertTo-Json -Compress)
    $startInfo.ArgumentList.Add('--no-warnings')
    $startInfo.ArgumentList.Add('--experimental-strip-types')
    $startInfo.ArgumentList.Add($generatorPath)

    $process = [Diagnostics.Process]::Start($startInfo)
    $serializedJson = $process.StandardOutput.ReadToEnd()
    $stderr = $process.StandardError.ReadToEnd()
    $process.WaitForExit()
    if ($process.ExitCode -ne 0) {
        throw "Failed to generate pi-subagents built-ins (exit $($process.ExitCode)): $stderr"
    }
    if ([string]::IsNullOrWhiteSpace($serializedJson)) {
        throw 'The pi-subagents serializer produced empty output.'
    }
    try {
        $generatedAgents = $serializedJson | ConvertFrom-Json
    }
    catch {
        throw "The pi-subagents serializer produced invalid JSON: $($_.Exception.Message)"
    }
    if (@($generatedAgents.PSObject.Properties).Count -ne $agentModels.Count) {
        throw 'The pi-subagents serializer returned an unexpected set of agents.'
    }

    New-Item -ItemType Directory -Path $OutputDirectory -Force | Out-Null
    foreach ($entry in $agentModels.GetEnumerator()) {
        $property = $generatedAgents.PSObject.Properties[$entry.Key]
        if ($null -eq $property) {
            throw "The pi-subagents serializer omitted '$($entry.Key)'."
        }
        $serialized = [string]$property.Value
        if ([string]::IsNullOrWhiteSpace($serialized)) {
            throw "The pi-subagents serializer produced empty output for '$($entry.Key)'."
        }

        $modelMatch = [regex]::Match($serialized, '(?m)^model: (.*)$')
        if ($null -eq $entry.Value) {
            if ($modelMatch.Success) {
                throw "The generated '$($entry.Key)' agent unexpectedly contains a model pin."
            }
        }
        elseif (-not $modelMatch.Success -or $modelMatch.Groups[1].Value -cne $entry.Value) {
            throw "The generated '$($entry.Key)' agent has an unexpected model pin."
        }

        $outputPath = Join-Path $OutputDirectory "$($entry.Key).md"
        $existing = if (Test-Path -LiteralPath $outputPath -PathType Leaf) {
            [IO.File]::ReadAllText($outputPath)
        } else {
            $null
        }
        if ($existing -cne $serialized) {
            [IO.File]::WriteAllText($outputPath, $serialized, $utf8NoBom)
        }
    }
}
finally {
    if (Test-Path -LiteralPath $work) {
        Remove-Item -LiteralPath $work -Recurse -Force
    }
}
{{ end -}}
