{{- if eq .chezmoi.os "windows" -}}
{{- $pwsh := "C:/Program Files/PowerShell/7/pwsh.exe" -}}
{{- if hasKey . "llm_pwsh" -}}{{- $pwsh = .llm_pwsh -}}{{- end -}}
{{- $manifest := includeTemplate "llm/render.json.tmpl" (dict "root" . "target" "credentials") -}}
# No credential decryption occurs while this script is rendered, including diff.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
Set-StrictMode -Version Latest
$utf8 = [System.Text.UTF8Encoding]::new($false, $true)
$failure = 'Credential publication failed.'
$temporary = $null

function Invoke-CredentialChild([string]$Executable, [string[]]$Arguments, [string]$InputText) {
    $start = [System.Diagnostics.ProcessStartInfo]::new()
    $start.FileName = $Executable
    $start.UseShellExecute = $false
    $start.CreateNoWindow = $true
    $start.RedirectStandardInput = $true
    $start.RedirectStandardOutput = $true
    $start.RedirectStandardError = $true
    $start.StandardInputEncoding = $utf8
    $start.StandardOutputEncoding = $utf8
    $start.StandardErrorEncoding = $utf8
    # Isolate only child configuration controls, never modify the caller's or
    # persistent environment. Inherited CHEZMOI_OUTPUT/DEBUG/etc. must not turn
    # this private stdout pipe into a plaintext file or diagnostic stream.
    foreach ($name in @($start.Environment.Keys)) {
        if ($name.StartsWith('CHEZMOI_', [StringComparison]::OrdinalIgnoreCase)) {
            [void]$start.Environment.Remove($name)
        }
    }
    foreach ($argument in $Arguments) { [void]$start.ArgumentList.Add($argument) }
    $process = [System.Diagnostics.Process]::new()
    $process.StartInfo = $start
    try {
        [void]$process.Start()
        $stdout = $process.StandardOutput.ReadToEndAsync()
        $stderr = $process.StandardError.ReadToEndAsync()
        $write = $process.StandardInput.WriteAsync($InputText)
        if (-not $write.Wait(30000)) { throw 'Child input timed out.' }
        $process.StandardInput.Close()
        if (-not $process.WaitForExit(30000)) { throw 'Child process timed out.' }
        if (-not [System.Threading.Tasks.Task]::WaitAll([System.Threading.Tasks.Task[]]@($stdout, $stderr), 5000)) {
            throw 'Child output timed out.'
        }
        # Never pass child diagnostics through: decrypt/YAML errors can include plaintext.
        if ($process.ExitCode -ne 0) { throw 'Child operation failed.' }
        return $stdout.Result
    } finally {
        try { if (-not $process.HasExited) { $process.Kill($true); [void]$process.WaitForExit(5000) } } catch {}
        $process.Dispose()
    }
}

try {
    $failure = 'Credential manifest or required source helper is invalid.'
    $manifestJson = $utf8.GetString([Convert]::FromBase64String('{{ $manifest | b64enc }}'))
    $manifest = ConvertFrom-Json -AsHashtable -InputObject $manifestJson
    if ($manifest -isnot [System.Collections.IDictionary] -or $manifest.Count -ne 2 -or
        $manifest.schema_version -isnot [long] -or $manifest.schema_version -ne 1 -or
        $manifest.providers -isnot [System.Collections.IDictionary] -or $manifest.providers.Count -gt 128) {
        throw 'Invalid manifest.'
    }
    foreach ($id in $manifest.providers.Keys) {
        $binding = $manifest.providers[$id]
        if ($id -cnotmatch '\A[a-z][a-z0-9_-]{0,63}\z' -or
            $binding -isnot [System.Collections.IDictionary] -or $binding.Count -ne 1 -or
            $binding.secret_field -isnot [string] -or $binding.secret_field -cnotmatch '\A[a-z][a-z0-9_]{0,127}\z') {
            throw 'Invalid credential reference.'
        }
    }
    # Base64 carries data, not PowerShell syntax (including smart apostrophes).
    $source = $utf8.GetString([Convert]::FromBase64String('{{ .chezmoi.sourceDir | replace "\\" "/" | b64enc }}'))
    $destination = $utf8.GetString([Convert]::FromBase64String('{{ .chezmoi.destDir | replace "\\" "/" | b64enc }}'))
    $pwsh = $utf8.GetString([Convert]::FromBase64String('{{ $pwsh | replace "\\" "/" | b64enc }}'))
    $config = $utf8.GetString([Convert]::FromBase64String('{{ .chezmoi.configFile | replace "\\" "/" | b64enc }}'))
    $chezmoi = $utf8.GetString([Convert]::FromBase64String('{{ .chezmoi.executable | replace "\\" "/" | b64enc }}'))
    $helper = Join-Path $source 'dot_config/llm/credentials.ps1'
    if (-not [System.IO.File]::Exists($helper) -or -not [System.IO.File]::Exists($pwsh)) { throw 'Missing credential helper or PowerShell.' }
    $extraction = $utf8.GetString([Convert]::FromBase64String('{{ include ".chezmoitemplates/llm/credential-values.json.tmpl" | b64enc }}'))
    $override = ConvertTo-Json -InputObject @{ llm_credentials = $manifest } -Depth 6 -Compress
    $temporary = Join-Path ([System.IO.Path]::GetTempPath()) ('llm-credentials-' + [Guid]::NewGuid().ToString('N'))
    [void][System.IO.Directory]::CreateDirectory($temporary)
    $arguments = @(
        '--config', $config,
        '--source', $source, '--destination', $destination,
        '--persistent-state', (Join-Path $temporary 'state.boltdb'), '--cache', (Join-Path $temporary 'cache'),
        '--no-tty', '--no-pager', '--refresh-externals=never', '--color=false', '--progress=false',
        '--debug=false', '--verbose=false', '--output=', '--override-data', $override,
        'execute-template', '--stdinisatty=false'
    )
    $failure = 'Credential extraction failed or timed out; check the age identity and required string fields. Existing snapshot was not changed.'
    $payload = Invoke-CredentialChild $chezmoi $arguments $extraction
    $failure = 'Credential publication failed or timed out; check input, store ownership, permissions, and publisher lock. No credential values were logged.'
    $output = Invoke-CredentialChild $pwsh @(
        '-NoLogo', '-NoProfile', '-NonInteractive', '-File', $helper,
        '-Action', 'Publish', '-StoreDirectory', (Join-Path $destination '.config/llm/store')
    ) $payload
    if ($output.Length -ne 0) { throw 'Unexpected publisher output.' }
} catch {
    [Console]::Error.WriteLine($failure)
    exit 1
} finally {
    # Only encrypted persistent/cache data can be written here; plaintext uses pipes.
    if ($temporary) { try { [System.IO.Directory]::Delete($temporary, $true) } catch {} }
}
{{ end -}}
