{{ if eq .chezmoi.os "windows" -}}
# Run after every apply so the manual follows Scoop upgrades without a source pin.
param(
    [string]$CoreExecutable = '{{ .chezmoi.homeDir | replace "\\" "/" | replace "'" "''" }}/scoop/apps/herdr-core/current/herdr-core.exe',
    [string]$HomeRoot = '{{ .chezmoi.destDir | replace "\\" "/" | replace "'" "''" }}'
)

$ErrorActionPreference = 'Stop'
$utf8NoBom = [Text.UTF8Encoding]::new($false)
$ownershipMarker = '<!-- Generated by chezmoi: herdr-core-skill -->'

function Get-HerdrCoreManual([string]$Executable) {
    $startInfo = [Diagnostics.ProcessStartInfo]::new()
    $startInfo.FileName = $Executable
    $startInfo.UseShellExecute = $false
    $startInfo.RedirectStandardOutput = $true
    $startInfo.RedirectStandardError = $true
    $startInfo.StandardOutputEncoding = [Text.Encoding]::UTF8
    $startInfo.StandardErrorEncoding = [Text.Encoding]::UTF8
    $startInfo.ArgumentList.Add('--skill')
    $process = [Diagnostics.Process]::Start($startInfo)
    try {
        $stdout = $process.StandardOutput.ReadToEndAsync()
        $stderr = $process.StandardError.ReadToEndAsync()
        $process.WaitForExit()
        $manual = $stdout.GetAwaiter().GetResult()
        $errorText = $stderr.GetAwaiter().GetResult()
        if ($process.ExitCode -ne 0) {
            throw "HerdR Core --skill failed (exit $($process.ExitCode)): $errorText"
        }
        return $manual
    }
    finally {
        $process.Dispose()
    }
}

if (-not (Test-Path -LiteralPath $CoreExecutable -PathType Leaf)) {
    throw "HerdR Core is missing at '$CoreExecutable'. Run 'winget configure -f configuration.dsc.yaml' first."
}
$manual = Get-HerdrCoreManual $CoreExecutable
# v0.1.22 emits a manual, not discovery frontmatter. Stop for review if upstream
# changes that contract, rather than silently nesting headers or publishing help.
if ($manual -cnotmatch '\A# hc manual \(herdr-core\)\r?\n\s*\S') {
    throw 'HerdR Core --skill emitted an empty or unexpected manual; review its format before publishing.'
}
$content = @"
---
name: herdr-core
description: "Control HerdR Core with hc for persistent terminals, agent coordination, background commands, and remote machines."
---

$ownershipMarker

Use ``hc``, not the legacy ``herdr`` command. If ``HC_TERMINAL_ID`` is absent,
ask the user once this session before using HerdR Core for this work.

"@ + "`n" + $manual

$target = [IO.Path]::GetFullPath((Join-Path $HomeRoot '.local/share/herdr-core/skills/herdr-core'))
$skillPath = Join-Path $target 'SKILL.md'
$links = @(
    '.agents/skills/herdr-core',
    '.claude/skills/herdr-core',
    '.codex/skills/herdr-core',
    '.copilot/skills/herdr-core',
    '.config/opencode/skills/herdr-core'
) | ForEach-Object { Join-Path $HomeRoot $_ }

# Preflight every destination before changing any generated file or link.
foreach ($path in @($skillPath) + $links) {
    $parent = Split-Path -Parent $path
    while ($parent -and -not $parent.Equals([IO.Path]::GetFullPath($HomeRoot), [StringComparison]::OrdinalIgnoreCase)) {
        $entry = Get-Item -LiteralPath $parent -Force -ErrorAction SilentlyContinue
        if ($null -ne $entry -and (
            -not $entry.PSIsContainer -or ($entry.Attributes -band [IO.FileAttributes]::ReparsePoint)
        )) {
            throw "Refusing redirected HerdR Core output parent '$parent'."
        }
        $parent = Split-Path -Parent $parent
    }
}
$existingSkill = Get-Item -LiteralPath $skillPath -Force -ErrorAction SilentlyContinue
if ($null -ne $existingSkill -and (
    $existingSkill.PSIsContainer -or
    ($existingSkill.Attributes -band [IO.FileAttributes]::ReparsePoint) -or
    -not ([IO.File]::ReadAllText($skillPath).Contains($ownershipMarker))
)) {
    throw "Refusing non-owned HerdR Core skill at '$skillPath'."
}
$missingLinks = @()
foreach ($link in $links) {
    $existing = Get-Item -LiteralPath $link -Force -ErrorAction SilentlyContinue
    if ($null -eq $existing) {
        $missingLinks += $link
        continue
    }
    if (
        $existing.LinkType -ne 'SymbolicLink' -or
        -not $existing.PSIsContainer -or
        -not [IO.Path]::IsPathFullyQualified([string]$existing.LinkTarget) -or
        -not [IO.Path]::GetFullPath([string]$existing.LinkTarget).Equals($target, [StringComparison]::OrdinalIgnoreCase)
    ) {
        throw "Refusing non-owned HerdR Core skill link at '$link'."
    }
}

if ($null -eq $existingSkill -or [IO.File]::ReadAllText($skillPath) -cne $content) {
    New-Item -ItemType Directory -Path $target -Force | Out-Null
    $temporary = Join-Path $target ('.SKILL-' + [Guid]::NewGuid().ToString('N') + '.tmp')
    try {
        [IO.File]::WriteAllText($temporary, $content, $utf8NoBom)
        [IO.File]::Move($temporary, $skillPath, $true)
    }
    finally {
        Remove-Item -LiteralPath $temporary -Force -ErrorAction SilentlyContinue
    }
}
foreach ($link in $missingLinks) {
    New-Item -ItemType Directory -Path (Split-Path -Parent $link) -Force | Out-Null
    New-Item -ItemType SymbolicLink -Path $link -Target $target | Out-Null
}
{{ end -}}
