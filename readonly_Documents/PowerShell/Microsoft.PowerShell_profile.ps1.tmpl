#region Environment Variables

# yazi: file(1) executable
# see https://yazi-rs.github.io/docs/installation#windows
$Env:YAZI_FILE_ONE = "$Env:USERPROFILE\scoop\apps\git\current\usr\bin\file.exe"

# eza: the number of spaces to print between icon and filename
$Env:EZA_ICON_SPACING = 2

# default editor
$Env:EDITOR = "nvim"

# bat config directory
$Env:BAT_CONFIG_DIR = "$Env:USERPROFILE\.config\bat"

# PAGER
$Env:PAGER = "moor"
$Env:MOOR = "--no-linenumbers --statusbar=bold --tab-size=2 --style=catppuccin-mocha"

# lazygit config
$Env:LG_CONFIG_FILE = "$Env:LOCALAPPDATA\lazygit\config.yml,$Env:LOCALAPPDATA\lazygit\{{ .colorscheme }}-blue.yml";

# Credentials are never exported or cleaned up by this profile. Codex and Pi
# retrieve provider keys through the chezmoi-managed DPAPI helper. Native logins
# remain client-owned; OpenCode/MCP environment credentials are externally supplied.

# OpenCode 2.2+: keep native .agents/.opencode discovery, excluding Claude roots.
$Env:OPENCODE_DISABLE_CLAUDE_CODE_SKILLS = "1"

# pi: runtime behavior supplied by nixfiles' wrapper
# Forward copies through terminals/multiplexers even without SSH detection.
$Env:PI_CLIPBOARD_OSC52 = "1"
# Scoop exposes Starship directly on PATH instead of creating a shim.
$Env:PI_STATUSLINE_STARSHIP = "{{ .chezmoi.homeDir | replace "\\" "/" }}/scoop/apps/starship/current/starship.exe"
$Env:PI_SKIP_VERSION_CHECK = "1"
$Env:PI_TELEMETRY = "0"

#endregion Environment Variables


#region Functions

# alias for chezmoi
function cz
{
  chezmoi $args
}

# alias for entering local chezmoi repository
function czcd
{
  Set-Location $(chezmoi source-path)
}

# alias for launching yazi
function y
{
    $tmp = [System.IO.Path]::GetTempFileName()
    yazi $args --cwd-file="$tmp"
    $cwd = Get-Content -Path $tmp
    if (-not [String]::IsNullOrEmpty($cwd) -and $cwd -ne $PWD.Path) {
        Set-Location -LiteralPath $cwd
    }
    Remove-Item -Path $tmp
}

Function l
{
  eza --icons --no-quotes --group-directories-first --no-symlinks $args
}

Function ll
{
  eza --header --icons --long --octal-permissions --binary --group --time-style='+%F %T' --color-scale=age --no-quotes --group-directories-first --all $args
}

Function lt
{
  eza --header --icons --long --octal-permissions --binary --group --time-style='+%F %T' --color-scale=age --no-quotes --group-directories-first --all --tree $args
}

Function lg
{
  lazygit @args
}

Function cc
{
  claude --model "claude-opus-5-5[1m]" @args
}

# OpenCode 2 reads its default model from opencode.json; its full-screen CLI no
# longer accepts the V1 --model launch flag.
Function oc
{
  opencode @args
}

# Pi launch boundary: keep any external DeepSeek key for other clients, but do
# not auto-enable Pi's native provider alongside the selected Magpie route.
# Resolve the application explicitly to avoid recursing into this function.
Function pi
{
  $command = Get-Command pi.exe -CommandType Application -ErrorAction Stop
  $hadDeepSeekKey = Test-Path Env:DEEPSEEK_API_KEY
  $deepSeekKey = $Env:DEEPSEEK_API_KEY
  try {
    Remove-Item Env:DEEPSEEK_API_KEY -ErrorAction SilentlyContinue
    if ($MyInvocation.ExpectingInput) {
      $input | & $command.Source @args
    } else {
      & $command.Source @args
    }
  } finally {
    if ($hadDeepSeekKey) {
      $Env:DEEPSEEK_API_KEY = $deepSeekKey
    } else {
      Remove-Item Env:DEEPSEEK_API_KEY -ErrorAction SilentlyContinue
    }
  }
}

# alias for HerdR, mirroring the `hdr` shell alias from nixfiles' HerdR module.
Function hdr
{
  herdr @args
}

# alias for zellij, mirroring the `zj` shell alias from nixfiles' zellij module.
Function zj
{
  zellij @args
}

#endregion Functions

# Codex shells do not always populate CODEX_SANDBOX, but they do expose
# other Codex-specific variables. Skip interactive shell integrations there.
$IsCodexSession = (
    -not [string]::IsNullOrWhiteSpace($env:CODEX_SANDBOX) -or
    -not [string]::IsNullOrWhiteSpace($env:CODEX_THREAD_ID) -or
    -not [string]::IsNullOrWhiteSpace($env:CODEX_SANDBOX_NETWORK_DISABLED)
)

#region Terminal Title
# Starship calls this before each prompt render.
# Emit OSC 7 (CWD) and OSC 2 (tab title) so terminals like WezTerm know where we are.
function Invoke-Starship-PreCommand {
    $loc = $executionContext.SessionState.Path.CurrentLocation
    if ($loc.Provider.Name -eq "FileSystem") {
        $esc = [char]27
        $providerPath = $loc.ProviderPath -replace "\\", "/"
        # OSC 7: current working directory
        $osc7 = "${esc}]7;file://${env:COMPUTERNAME}/${providerPath}${esc}\"
        # OSC 2: tab title
        # Use starship's directory module for fish-style truncated paths
        $title = (starship module directory 2>$null) -replace "`e\[[0-9;]*m", ""
        $title = $title.Trim()
        if (-not $title) { $title = $loc.ProviderPath }
        $osc2 = "${esc}]2;${title}${esc}\"
        $host.ui.Write("${osc7}${osc2}")
    }
}
#endregion Terminal Title

# Skip interactive bits if it's a Codex session
if ($IsCodexSession) {
    return
}

# Emacs keybinding for PowerShell
Set-PSReadLineOption -EditMode Emacs

# Make PowerShell's autocompletion bash-like
Set-PSReadlineKeyHandler -Key Tab -Function MenuComplete

# fzf colorscheme — applies $env:FZF_DEFAULT_OPTS using the chezmoi
# `colorscheme` value (catppuccin theme files come from catppuccin/fzf
# via .chezmoiexternal, gruvbox-dark is inlined). Must run before PSFzf
# imports so the module honors the colors.
. "$env:USERPROFILE\.config\fzf\init.ps1"

# PSFzf — fuzzy command-line history (Ctrl+R) backed by fzf. The module
# replaces PSReadLine's ReverseSearchHistory handler. Installed by the
# DSC config (ScriptResource: InstallPSFzfModule); warn instead of
# erroring out if the module is missing so the rest of the profile
# still loads on a half-bootstrapped machine.
if (Get-Module -ListAvailable -Name PSFzf) {
    Import-Module PSFzf
    Set-PsFzfOption -PSReadlineChordReverseHistory 'Ctrl+r'
    Set-PsFzfOption -PSReadlineChordProvider 'Ctrl+t'
} else {
    Write-Warning "PSFzf not installed; Ctrl+R fuzzy history disabled. Run the DSC config or: Install-Module PSFzf -Scope CurrentUser"
}

# This is recommended to be the last expression in $PROFILE
Invoke-Expression (&starship init powershell)

# But zoxide doesn't work if it is before starship, see https://github.com/ajeetdsouza/zoxide/issues/74
Invoke-Expression (& { (zoxide init powershell | Out-String) })
