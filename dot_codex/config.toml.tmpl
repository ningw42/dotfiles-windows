model = "gpt-6.1-sol"
model_provider = "{{ .codex_provider }}"
model_reasoning_effort = "xhigh"
suppress_unstable_features_warning = true
approval_policy = "on-request"
approvals_reviewer = "auto_review"

[model_providers.agent-maestro]
name = "Agent Maestro"
base_url = "http://localhost:23333/api/openai/v1/"
wire_api = "responses"
stream_idle_timeout_ms = 600000

[model_providers.router-maestro]
name = "Router Maestro"
base_url = "https://router-maestro.ningw.net/api/openai/v1/"
env_key = "CODEX_API_KEY"
wire_api = "responses"
stream_idle_timeout_ms = 600000

[model_providers.litellm]
name = "LiteLLM"
base_url = "https://litellm.ningw.net/openai/v1/"
env_key = "CODEX_API_KEY"
wire_api = "responses"
stream_idle_timeout_ms = 600000

[model_providers.copilot-proxy]
name = "Copilot Proxy"
base_url = "https://copilot.ningw.net/v1/"
wire_api = "responses"
stream_idle_timeout_ms = 600000

[model_providers.copilot-proxy.auth]
command = "pwsh"
args = ["-NoProfile", "-NonInteractive", "-Command", "[Console]::Out.Write($env:CODEX_API_KEY)"]
timeout_ms = 5000
refresh_interval_ms = 0

[model_providers.copilotd]
name = "copilotd"
base_url = "https://copilotd.ningw.net/openai/v1"
wire_api = "responses"
supports_websockets = true
stream_idle_timeout_ms = 600000

[model_providers.copilotd.auth]
command = "pwsh"
args = ["-NoProfile", "-NonInteractive", "-Command", "[Console]::Out.Write($env:CODEX_API_KEY)"]
timeout_ms = 5000
refresh_interval_ms = 0

[projects.'\\?\C:\Users\ningw\GitHub\Hypersonic']
trust_level = "trusted"

[projects.'\\?\C:\Users\ningw\.local\share\chezmoi']
trust_level = "trusted"

[tui]
status_line = ["model-with-reasoning", "current-dir", "project-root", "git-branch", "context-used"]

[tui.keymap.editor]
# Rio and Zellij on Windows can surface Ctrl+J as Ctrl+Enter through ConPTY.
# This setting replaces Codex's defaults, so retain them and add the alias.
insert_newline = ["ctrl-j", "ctrl-m", "enter", "shift-enter", "alt-enter", "ctrl-enter"]

[tui.model_availability_nux]
"gpt-5.5" = 4
"gpt-5.6-sol" = 4

[notice.model_migrations]
"gpt-5.3-codex" = "gpt-5.4"

[windows]
sandbox = "elevated"

[features]
goals = true
hooks = true

# Codex executes user hooks only after their normalized definitions are trusted.
# Keep the native Windows path because Codex includes it verbatim in the hook key.
[hooks.state.{{ printf "%s:session_start:0:0" (joinPath .chezmoi.homeDir ".codex" "hooks.json") | quote }}]
# Computed from Codex 0.159.3's hooks/list response for the Herdr handler in
# hooks.json. Refresh this hash if its command, timeout, event, or position changes.
trusted_hash = "sha256:06548a65d143720b4561305061a21564fd877484854338649a2f447e27994852"

[mcp_servers.brave-search]
url = "https://brave-search-mcp.ningw.net/mcp"

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"
env_http_headers = { CONTEXT7_API_KEY = "CONTEXT7_API_KEY" }

[mcp_servers.exa]
url = "https://mcp.exa.ai/mcp"

[mcp_servers.github]
url = "https://api.githubcopilot.com/mcp/"
bearer_token_env_var = "GITHUB_PERSONAL_ACCESS_TOKEN"

[marketplaces.openai-bundled]
last_updated = "2026-05-09T00:53:03Z"
source_type = "local"
source = '\\?\C:\Users\ningw\.codex\.tmp\bundled-marketplaces\openai-bundled'

[plugins."browser-use@openai-bundled"]
enabled = true

[sandbox_workspace_write]
network_access = true

[desktop]
show-context-window-usage = true
enabled-reasoning-efforts = ["low", "medium", "high", "xhigh", "max", "ultra"]
