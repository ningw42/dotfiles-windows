{{- /* This template is sent as literal stdin to the isolated child, never evaluated by apply/diff. */ -}}
{{- $manifest := .llm_credentials -}}
{{- if not (kindIs "map" $manifest) -}}{{ fail "Invalid credential manifest." }}{{- end -}}
{{- if ne (toString $manifest.schema_version) "1" -}}{{ fail "Unsupported credential manifest." }}{{- end -}}
{{- if not (kindIs "map" $manifest.providers) -}}{{ fail "Invalid credential provider map." }}{{- end -}}
{{- $values := dict -}}
{{- if gt (len $manifest.providers) 0 -}}
{{- $secrets := include "secrets.yaml.age" | decrypt | fromYaml -}}
{{- if not (kindIs "map" $secrets) -}}{{ fail "Invalid credential document." }}{{- end -}}
{{- range $id, $binding := $manifest.providers -}}
{{- if not (kindIs "map" $binding) -}}{{ fail "Invalid credential binding." }}{{- end -}}
{{- $field := $binding.secret_field -}}
{{- if not (kindIs "string" $field) -}}{{ fail "Invalid credential field reference." }}{{- end -}}
{{- if not (hasKey $secrets $field) -}}{{ fail "Required credential field is missing." }}{{- end -}}
{{- $value := index $secrets $field -}}
{{- if not (kindIs "string" $value) -}}{{ fail "Required credential field must be a string." }}{{- end -}}
{{- if eq (len $value) 0 -}}{{ fail "Required credential field is empty." }}{{- end -}}
{{- $_ := set $values $id $value -}}
{{- end -}}
{{- end -}}
{{- dict "schema_version" 1 "providers" $values | toJson -}}
