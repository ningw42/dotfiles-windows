          }
        }
      },
      "name": "copilotd (OpenAI)",
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "{env:COPILOTD_API_KEY}",
        "baseURL": "https://copilotd.ningw.net/openai/v1"
      }
    },
