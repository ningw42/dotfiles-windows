{
  "$schema": "https://opencode.ai/config.json",
  "model": "copilotd-responses/gpt-6.1-sol",
  "plugins": [
    "-opencode.config.compatibility"
  ],
  "skills": [
    "{{ .chezmoi.homeDir | replace "\\" "/" }}/.agents/skills",
    ".agents/skills"
  ],
  "enabled_providers": [
    "copilotd-responses",
    "deepseek-responses",
    "magpie-generative-ai",
    "magpie-responses"
  ],
  "mcp": {
    "brave-search": {
      "enabled": true,
      "type": "remote",
      "url": "https://brave-search-mcp.ningw.net/mcp"
    },
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "exa": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "github": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/"
    }
  },
  "permission": {
    "skill": {
      "close-code-review": "deny",
      "develop-and-squash": "deny",
      "develop-and-submit-pr": "deny",
      "simplification-review": "deny",
      "subagent-parity": "deny",
      "traceability": "deny",
      "unlimited-subagent-turns": "deny"
    }
  },
  "provider": {
    "copilotd-responses": {
      "models": {
        "gpt-6-luna": {
          "cost": {
            "cache_read": 0.01,
            "input": 0.1,
            "output": 0.5
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "GPT-6 Luna",
          "options": {
            "reasoningEffort": "xhigh"
          },
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
