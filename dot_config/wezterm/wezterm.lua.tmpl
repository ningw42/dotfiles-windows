-- Pull in the wezterm API
local wezterm = require 'wezterm'

-- This will hold the configuration.
local config = wezterm.config_builder()

-- Global constants
--
-- Font stack, mirroring the cascade Windows Terminal and rio use:
-- Berkeley for Latin -> Symbols Nerd Font Berkeley Mono for icons -> Sarasa for CJK.
--
-- Spelling Retina is the trap. It is weight 375, which has no CSS-style name, and
-- Berkeley's name table disagrees with itself about where it lives: name ID 1 calls
-- it its own family ("Berkeley Mono Retina ExtraCondensed") while ID 16 files it
-- under "Berkeley Mono". WezTerm enumerates through DirectWrite and reports the ID 16
-- typographic family, so here it is family "Berkeley Mono" plus a NUMERIC weight and
-- an explicit stretch. Do NOT copy rio's spelling: rio resolves through font-kit's
-- select_family_by_name, which sees the ID 1 side and needs family
-- "Berkeley Mono Retina". Same file, two incompatible descriptors. Ground truth for
-- this side is `wezterm ls-fonts --list-system`, which prints copy-pasteable
-- wezterm.font(...) calls next to the file each one resolves to.
--
-- "SemiBold" is likewise not a wezterm weight name -- 600 is spelled "DemiBold".
local function berkeley(weight, style)
  return {
    family = 'Berkeley Mono',
    weight = weight,
    stretch = 'ExtraCondensed',
    style = style,
    harfbuzz_features = { 'ss02=1' },
  }
end

-- Icons before CJK: the ExtraCondensed OTFs are the plain 645-glyph cut with no Nerd
-- coverage at all, so without the symbols font in this chain every icon falls through
-- to the "Symbols Nerd Font Mono" wezterm bundles -- a different design at a different
-- advance than the metrics-matched Berkeley one WT and rio both use (0.4878 em against
-- Berkeley's 0.4880). Sarasa is last and CJK-only in practice; it advances a full em on
-- ideographs, so they take two cells.
local function font_stack(weight, style)
  return wezterm.font_with_fallback {
    berkeley(weight, style),
    'Symbols Nerd Font Berkeley Mono',
    'Sarasa Fixed SC',
    'PragmataPro Mono',
  }
end

local font_regular = font_stack(375, 'Normal')
local font_italic = font_stack(375, 'Oblique')
local font_bold = font_stack('DemiBold', 'Normal')
local font_bold_italic = font_stack('DemiBold', 'Oblique')

-- Helper functions
-- Helper to merge two tables, like nix's // operator
local function merge(a, b)
  local result = {}

  -- copy all keys from a first
  for k, v in pairs(a) do
    result[k] = v
  end

  -- update/override from b
  for k, v2 in pairs(b) do
    local v1 = result[k]
    if type(v1) == "table" and type(v2) == "table" then
      result[k] = merge(v1, v2)
    else
      result[k] = v2
    end
  end

  return result
end

