-- Fonts
--
-- Load Berkeley by parsing the files directly instead of going through the system
-- font locator. On Windows that locator is GDI, and GDI only exposes the RIBBI four
-- -- Regular, Bold, and their obliques -- under family "Berkeley Mono ExtraCondensed".
-- The other ten weights are registered as sibling families named the other way round
-- ("Berkeley Mono ExtraCondensed SemiBold", ID 1) and wezterm's matcher reaches them
-- by neither route: asking family "Berkeley Mono" + weight="DemiBold" + the right
-- stretch falls all the way through to JetBrains Mono, and asking the sibling family
-- by name silently snaps to Regular instead. Retina survives on the ID 16 path by
-- luck -- 375, 425 and 900 resolve, every named weight in between does not -- so a
-- config that looks like it works can still be quietly rendering the wrong face.
-- `wezterm ls-fonts` (no args) names the face per slot and warns when a font_rule
-- missed; that warning is the only signal, since the fallback is silent at runtime.
--
-- This is the same per-user directory configuration.dsc.yaml installs into, so it
-- also covers Sarasa and the symbols font. Recursive, which matters: Sarasa lands in
-- a SarasaFixedSC/ subdirectory.
config.font_dirs = { '{{ .chezmoi.homeDir | replace "\\" "/" }}/AppData/Local/Microsoft/Windows/Fonts' }
config.font = font_regular
-- Pin every intensity/italic slot by hand rather than piling the four Berkeley faces
-- into one font_with_fallback and letting wezterm sort them out. Left to itself it
-- derives each slot by rewriting the attributes of the WHOLE chain, not just the first
-- entry, so dim text was resolving CJK to "Sarasa Fixed SC XLight" and dim italic to
-- SARASAFIXEDSC-EXTRALIGHTITALIC.TTF -- a weight nothing asked for. `wezterm ls-fonts`
-- (no args) prints the resolved chain per slot and is how that turned up.
config.font_rules = {
  { intensity = 'Normal', italic = true, font = font_italic },
  { intensity = 'Bold', italic = false, font = font_bold },
  { intensity = 'Bold', italic = true, font = font_bold_italic },
  -- Half maps onto the same faces as Normal; wezterm synthesizes the dimming.
  { intensity = 'Half', italic = false, font = font_regular },
  { intensity = 'Half', italic = true, font = font_italic },
}
config.font_size = 14.0
config.line_height = 0.95
-- Greyscale AA, not the "HorizontalLcd" subpixel target this used to carry: every
-- display here is HiDPI, where the subpixel triads are far below the point of
-- buying real horizontal resolution and mostly show up as colour fringing on the
-- stems. `freetype_render_target` defaults to whatever `freetype_load_target` is,
-- so this single line switches both the hinting algorithm and the rasterisation.
-- Matches Windows Terminal's `antialiasingMode: "grayscale"`. rio and alacritty
-- are the odd ones out and stay subpixel -- neither exposes the knob (rio's
-- `fonts.antialias` PR #1718 is still unmerged as of 0.5.5, and crossfont
-- hardcodes DWRITE_TEXTURE_CLEARTYPE_3x1).
config.freetype_load_target = "Light"

-- Off so U+2500 box drawing, powerline separators and the U+EE00-EE02 progress bar all
-- come from the font, matching WT and rio glyph-for-glyph. Note this is the opposite
-- setting from theirs -- WT sets `builtinGlyphs: true` and rio `use-drawable-chars =
-- true`, i.e. both self-draw -- but wezterm nightly ALSO self-draws the Nerd Fonts
-- progress and git-branch ranges, which those two do not, and the toggle is all-or-
-- nothing (no per-range control exists). Safe only because of the chain above: the
-- ExtraCondensed cut ships 25 of the 128 box glyphs and 4 of 8 powerline separators,
-- and Symbols Nerd Font Berkeley Mono backfills both at 128/128 and 8/8. Braille
-- (U+2800) is the one gap -- neither Berkeley face nor the symbols font has any, so it
-- lands on Sarasa at 0.5 em against a 0.4880 em cell. Flip back to true if that or the
-- mixed box-drawing design bites.
config.custom_block_glyphs = false

-- The symbols font draws icon ink far wider than its own advance -- U+F015 is 0.9750 em
-- of ink on a 0.4878 em advance, a clean 2.00x, and half the icons measured are between
-- 1.5x and 2.0x. That is how WT and rio render them too: the ink spills into the
-- neighbouring cell. wezterm instead scales such a glyph down to fit unless it is
-- allowed to overflow, and the default "WhenFollowedBySpace" only permits that when the
-- next cell happens to be blank -- so the same icon renders at two different sizes
-- depending on what follows it, and adjacent runs like the U+EE00-EE02 progress bar are
-- always shrunk. "Always" drops the condition. Applies only to glyphs with an ink aspect
-- ratio above 0.9, which is 7 of the 10 icons sampled here.
config.allow_square_glyphs_to_overflow_width = 'Always'

