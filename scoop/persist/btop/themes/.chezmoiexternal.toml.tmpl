{{- /* Fetch the matching catppuccin btop theme into btop4win's themes/ dir
       (referenced by color_theme in ../btop.conf). gruvbox-dark needs no entry
       -- it uses btop4win's bundled "gruvbox_dark_v2.theme". Checksums refreshed
       via update_externals.py, matching the repo's other catppuccin externals. */ -}}
{{ if eq .colorscheme "catppuccin-latte" }}
["catppuccin_latte.theme"]
    type = "file"
    url = "{{ .external_resources.pins.catppuccin_btop_latte.url }}"
    checksum.sha256 = "{{ .external_resources.pins.catppuccin_btop_latte.sha256 }}"
{{ else if eq .colorscheme "catppuccin-frappe" }}
["catppuccin_frappe.theme"]
    type = "file"
    url = "{{ .external_resources.pins.catppuccin_btop_frappe.url }}"
    checksum.sha256 = "{{ .external_resources.pins.catppuccin_btop_frappe.sha256 }}"
{{ else if eq .colorscheme "catppuccin-macchiato" }}
["catppuccin_macchiato.theme"]
    type = "file"
    url = "{{ .external_resources.pins.catppuccin_btop_macchiato.url }}"
    checksum.sha256 = "{{ .external_resources.pins.catppuccin_btop_macchiato.sha256 }}"
{{ else if eq .colorscheme "catppuccin-mocha" }}
["catppuccin_mocha.theme"]
    type = "file"
    url = "{{ .external_resources.pins.catppuccin_btop_mocha.url }}"
    checksum.sha256 = "{{ .external_resources.pins.catppuccin_btop_mocha.sha256 }}"
{{ end }}
